{
  "format": "equinox-forge-specific-general-numeric-runtime-contract-v1",
  "version": "0.48",
  "requirements": {
    "runtime_must_execute_after_forge_db_is_closed": true,
    "runtime_core_relations_must_be_numeric": true,
    "resolution_must_start_at_the_specific_subject": true,
